{
  "expo": {
    "name": "Partidas de Rumi",
    "slug": "partidas-de-rumi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "entryPoint": "./index.ts",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1629"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.partidasderumi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
